# TenantVoice — FastAPI backend environment
# Copy to .env and fill in the two Supabase values. Everything else has a
# working default for local development.
#
#   cp .env.example .env
#
# Settings are loaded by app/core/config.py (pydantic-settings). Names here must
# match the fields on Settings, case-insensitively.

# ---------------------------------------------------------------------------
# App (all optional — these are the defaults)
# ---------------------------------------------------------------------------
APP_NAME=TenantVoice API
APP_ENV=development

# Prefix every route is mounted under. The frontend's NEXT_PUBLIC_API_URL must
# end with this same value.
API_PREFIX=/api/v1

# Comma-separated list of browser origins allowed to call this API.
# Add the deployed frontend origin here when you deploy.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (REQUIRED — the app will not start without these)
# ---------------------------------------------------------------------------
# Supabase dashboard → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase dashboard → Project Settings → API Keys → service_role (secret).
#
# SECRET. This key bypasses Row-Level Security and can create/delete auth users
# — the backend relies on that for /auth/register (admin.create_user) and for
# all data access. Never commit it, never expose it to the browser, never put it
# in a NEXT_PUBLIC_* variable. The frontend needs no Supabase key at all: it
# talks only to this API, which proxies auth and returns a scoped user JWT.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
